    "CFBundleName" : {
      "comment" : "Bundle name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OpenGYM"
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "读取体重以显示趋势并同步到你的 openGym 账号；读取训练、心率、活动与静息能量以显示运动和热量（kcal）。运动健康指标仅保存在设备与 Apple 健康中。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read body weight to chart your progress in openGym. Read workouts, heart rate, active and resting energy to show activity and calories (kcal). Health metrics stay on your devices and in Apple Health."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读取体重以在 openGym 中显示趋势；读取训练、心率、活动与静息能量以显示运动和热量（kcal）。运动健康指标仅保存在设备与 Apple 健康中。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "将你在 openGym 开始和结束的训练及系统生成的活动能量保存到 Apple 健康，并在健身 App 中显示。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save workouts you start and finish in openGym, along with activity energy recorded by the system, to Apple Health and show them in the Fitness app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将你在 openGym 开始和结束的训练及系统生成的活动能量保存到 Apple 健康，并在健身 App 中显示。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "开启「添加位置和天气」后，openGym 会在训练开始时读取一次你的位置，并随训练保存到 Apple 健康。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you turn on location and weather for Apple Fitness, openGym reads where you are once as a workout starts and saves it with the workout in Apple Health."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启「添加位置和天气」后，openGym 会在训练开始时读取一次你的位置，并随训练保存到 Apple 健康。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}