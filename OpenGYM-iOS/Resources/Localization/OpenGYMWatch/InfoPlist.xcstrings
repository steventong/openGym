{
  "sourceLanguage": "en",
  "strings": {
    "NSHealthShareUsageDescription": {
      "comment": "读取本次训练的心率、活动与静息能量，用于显示心率、活动热量和总热量（kcal）。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read heart rate, active and resting energy during this workout to display heart rate, active calories and total calories (kcal)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取本次训练的心率、活动与静息能量，用于显示心率、活动热量和总热量（kcal）。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "comment": "将你在 openGym 开始和结束的训练及系统生成的活动能量保存到 Apple 健康，并在健身 App 中显示。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save workouts you start and finish in openGym, along with activity energy recorded by the system, to Apple Health and show them in the Fitness app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将你在 openGym 开始和结束的训练及系统生成的活动能量保存到 Apple 健康，并在健身 App 中显示。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
