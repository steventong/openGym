      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue unfinished workouts in order. The next round starts the day after the current round ends. Clearing the order stops the rotation; switching to a fixed weekly schedule keeps the rotation order."
          }
        },
        "zh-Hans": {
          "stringUnit": {
