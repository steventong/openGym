    "HEALTH_HISTORY_CHECK_BEFORE_RETRY": {
      "comment": "可重新同步。每次只会先删除同步 ID 完全匹配的 openGym 历史补传，再保存；没有匹配 ID 的记录不会删除。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can retry syncing. Each attempt deletes only the openGym history export with the exact same sync ID before saving. Records without a matching ID are left unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可重新同步。每次只会先删除同步 ID 完全匹配的 openGym 历史补传，再保存；没有匹配 ID 的记录不会删除。"
          }
        }
      }
    },
    "HEALTH_HISTORY_INVALID_RECORD": {
      "comment": "这条训练缺少有效记录标识，无法同步到 Apple 健康。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This workout has no valid record identifier and cannot be synced to Apple Health."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这条训练缺少有效记录标识，无法同步到 Apple 健康。"
          }
        }
      }
    },
    "HEALTH_HISTORY_INVALID_TIME": {
      "comment": "请检查训练的起止时间。时长须大于 0 且不超过 24 小时，结束时间不能在未来。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the workout's start and end times. Duration must be greater than zero and no more than 24 hours, and the end cannot be in the future."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查训练的起止时间。时长须大于 0 且不超过 24 小时，结束时间不能在未来。"
          }
        }
      }
    },
    "HEALTH_HISTORY_SYNC_COMPLETE": {
      "comment": "训练已同步到 Apple 健康。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Workout synced to Apple Health."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "训练已同步到 Apple 健康。"
          }
        }
      }
    },
    "HEALTH_HISTORY_SYNC_CONFIRMATION": {
      "comment": "先删除由 openGym 补传且同步 ID 完全一致的记录，再按最新标题、起止时间和时长新增。找不到匹配 ID 就不删除。无法恢复原始心率和热量。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First delete the workout previously exported by openGym with the exact same sync ID, then save its latest title, start and end times, and duration. If no ID matches, nothing is deleted. Original heart rate and calorie data cannot be restored."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先删除由 openGym 补传且同步 ID 完全一致的记录，再按最新标题、起止时间和时长新增。找不到匹配 ID 就不删除。无法恢复原始心率和热量。"
          }
        }
      }
    },
    "HEALTH_HISTORY_SYNC_IN_PROGRESS": {
      "comment": "正在同步训练到 Apple 健康，请稍候。",
