    "AUTOMATIC_WORKOUT_SYNC_INFO": {
      "comment": "\n\n自动同步只处理开启后开始的新训练。历史训练可在单条记录菜单中手动同步，仅重建标题和时长。实时心率和热量优先由已连接的 Apple Watch 记录。运动健康指标仅保留在设备与 Apple 健康中。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nAutomatic sync includes new workouts started after enabling it. Past workouts can be synced manually from each history record's menu; only the title and duration are recreated. A connected Apple Watch is preferred for live heart rate and calorie tracking. Health metrics stay on your devices and in Apple Health."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n自动同步只处理开启后开始的新训练。历史训练可在单条记录菜单中手动同步，仅重建标题和时长。实时心率和热量优先由已连接的 Apple Watch 记录。运动健康指标仅保留在设备与 Apple 健康中。"
          }
        }
      }
    },
